@inherits LayoutComponentBase
@inject CarritoStateService CarritoState
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-none d-md-block text-muted small">
                <i class="bi bi-geo-alt-fill me-1" style="color: var(--brand-peach);"></i>
                <span>Envíos a todo el país | Narcisa Estudio de Interiores</span>
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <span class="badge rounded-pill px-3 py-2" style="background-color: var(--brand-peach-light); color: var(--brand-peach); border: 1px solid var(--brand-peach-soft);">
                    <i class="bi bi-person-circle me-1"></i> Cliente Demo
                </span>
                <a href="carrito" class="btn btn-outline-dark btn-sm px-3 py-2 d-flex align-items-center gap-2">
                    <i class="bi bi-bag"></i>
                    <span>Mi Carrito</span>
                    @if (CarritoState.CantidadTotalItems > 0)
                    {
                        <span class="badge rounded-pill bg-warning">
                            @CarritoState.CantidadTotalItems
                        </span>
                    }
                </a>
            </div>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        CarritoState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CarritoState.OnChange -= StateHasChanged;
    }
}
