@inherits LayoutComponentBase
@inject CarritoStateService CarritoState
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm">
            <div class="d-none d-md-block text-muted small">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> Entrega a todo el país | Narcisa Estudio Decoración
            </div>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <span class="badge bg-light text-dark border px-3 py-2">
                    <i class="bi bi-person-circle me-1 text-primary"></i> Cliente Demo
                </span>
                <a href="carrito" class="btn btn-outline-dark position-relative btn-sm px-3 py-2">
                    <i class="bi bi-cart3 me-1"></i> Carrito
                    @if (CarritoState.CantidadTotalItems > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark border border-white">
                            @CarritoState.CantidadTotalItems
                        </span>
                    }
                </a>
            </div>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        CarritoState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CarritoState.OnChange -= StateHasChanged;
    }
}
