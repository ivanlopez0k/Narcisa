@page "/proyectos"
@rendermode InteractiveAuto
@inject IHttpService HttpService
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mis Proyectos | Narcisa Estudio</PageTitle>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="font-serif fw-bold mb-1" style="color: var(--brand-text-dark); font-size: 2.2rem;">
                Mis Proyectos
            </h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                Explorá y gestioná tus ambientaciones guardadas en Narcisa Estudio.
            </p>
        </div>
        <div>
            <a href="simulador" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Nuevo Proyecto</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi @(isError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div>@feedbackMessage</div>
            <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="color: var(--brand-peach) !important;">
                <span class="visually-hidden">Cargando proyectos...</span>
            </div>
            <p class="text-muted mt-3">Recuperando tus ambientaciones...</p>
        </div>
    }
    else if (proyectos == null || proyectos.Count == 0)
    {
        <div class="card p-5 text-center my-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #fdfbf7 0%, #faeee5 100%);">
            <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3 shadow-sm"
                 style="width: 72px; height: 72px; background-color: var(--brand-peach-soft); color: var(--brand-peach);">
                <i class="bi bi-palette fs-2"></i>
            </div>
            <h3 class="font-serif fw-bold mb-2">Aún no creaste ningún proyecto</h3>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px; font-size: 0.95rem;">
                Usá nuestro simulador de ambientes interactivo para colocar muebles, lámparas y accesorios en espacios reales o fotos de tu propia casa.
            </p>
            <div>
                <a href="simulador" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-magic me-2"></i> Diseñar mi primer ambiente
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var proyecto in proyectos)
            {
                var totalEstimado = proyecto.Items.Sum(i => i.ProductoPrecio);
                <div class="col" @key="proyecto.Id">
                    <div class="card h-100 product-card overflow-hidden border">
                        <div class="position-relative" style="height: 200px; background-color: #f5ece3;">
                            <img src="@proyecto.ImagenUrl" 
                                 alt="@proyecto.Nombre" 
                                 class="w-100 h-100 object-fit-cover" 
                                 onerror="this.src='/images/ambientes/living-nordico.jpg'" />
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-warning rounded-pill px-2 py-1 shadow-sm">
                                    <i class="bi bi-box-seam me-1"></i> @proyecto.Items.Count @(proyecto.Items.Count == 1 ? "pieza" : "piezas")
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <div>
                                <h5 class="card-title font-serif fw-bold text-truncate mb-1" style="color: var(--brand-text-dark);" title="@proyecto.Nombre">
                                    @proyecto.Nombre
                                </h5>
                                <div class="text-muted small mb-3">
                                    <i class="bi bi-calendar3 me-1"></i> @proyecto.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>

                                @if (proyecto.Items.Count > 0)
                                {
                                    <div class="mb-3">
                                        <div class="small text-muted mb-1">Piezas seleccionadas:</div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var item in proyecto.Items.Take(4))
                                            {
                                                <span class="badge rounded-pill text-truncate" 
                                                      style="max-width: 130px; background-color: var(--brand-peach-light); color: var(--brand-text-dark); border: 1px solid var(--brand-peach-soft); font-size: 0.75rem;" 
                                                      title="@item.ProductoNombre">
                                                    @item.ProductoNombre
                                                </span>
                                            }
                                            @if (proyecto.Items.Count > 4)
                                            {
                                                <span class="badge rounded-pill text-muted" style="background-color: #ebdccd; font-size: 0.75rem;">
                                                    +@(proyecto.Items.Count - 4) más
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Presupuesto estimado:</div>
                                    <div class="fw-bold" style="color: var(--brand-peach); font-size: 1.1rem;">
                                        $ @totalEstimado.ToString("N0")
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-danger btn-sm" 
                                            title="Eliminar proyecto"
                                            @onclick="() => EliminarProyectoAsync(proyecto.Id)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <a href="simulador/@proyecto.Id" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        <span>Abrir</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ProyectoDTO> proyectos = new();
    private bool isLoading = true;
    private string? feedbackMessage;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectosAsync();
    }

    private int ObtenerUsuarioId()
    {
        return AuthState.UsuarioActual?.Id ?? 1;
    }

    private async Task CargarProyectosAsync()
    {
        try
        {
            isLoading = true;
            int usuarioId = ObtenerUsuarioId();
            var resp = await HttpService.GetAsync<List<ProyectoDTO>>($"api/proyectos/usuario/{usuarioId}");
            if (!resp.Error && resp.Respuesta != null)
            {
                proyectos = resp.Respuesta;
            }
            else
            {
                proyectos = new List<ProyectoDTO>();
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al cargar los proyectos: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EliminarProyectoAsync(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar este proyecto de diseño?");
        if (!confirmado) return;

        try
        {
            int usuarioId = ObtenerUsuarioId();
            var resp = await HttpService.DeleteAsync<object?>($"api/proyectos/{id}?usuarioId={usuarioId}");
            if (!resp.Error)
            {
                proyectos.RemoveAll(p => p.Id == id);
                feedbackMessage = "El proyecto fue eliminado exitosamente.";
                isError = false;
            }
            else
            {
                feedbackMessage = resp.Mensaje ?? "No se pudo eliminar el proyecto.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            feedbackMessage = $"Error al eliminar: {ex.Message}";
            isError = true;
        }
    }
}
