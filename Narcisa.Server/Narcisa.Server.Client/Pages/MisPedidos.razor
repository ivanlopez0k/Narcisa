@page "/mis-pedidos"
@inject IHttpService Http
@inject AuthStateService AuthState
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Mis Compras & Pedidos — Narcisa Estudio</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    <!-- Editorial Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm"
                  style="width: 52px; height: 52px; background-color: var(--brand-peach-light); color: var(--brand-peach);">
                <i class="bi bi-bag-check fs-3"></i>
            </span>
            <div>
                <h1 class="h3 fw-bold font-serif mb-1" style="color: var(--brand-text-dark);">Mis Compras & Pedidos</h1>
                <p class="text-muted small mb-0">Consultá el estado y seguimiento de tus compras en Narcisa Estudio.</p>
            </div>
        </div>
        <div>
            <a href="" class="btn btn-outline-dark btn-sm shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Explorar Catálogo
            </a>
        </div>
    </div>

    @if (!AuthState.EstaAutenticado)
    {
        <!-- Estado No Autenticado -->
        <div class="card border-0 shadow-sm text-center p-5 my-4" 
             style="background: linear-gradient(135deg, #fdfbf7 0%, #faeee5 100%); border: 1px solid #ebdccd !important;">
            <div class="card-body">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
                      style="width: 68px; height: 68px; background-color: #fff; color: var(--brand-peach);">
                    <i class="bi bi-person-lock fs-2"></i>
                </span>
                <h3 class="h4 fw-bold font-serif mb-2" style="color: var(--brand-text-dark);">Iniciá sesión para ver tus pedidos</h3>
                <p class="text-muted small mx-auto mb-4" style="max-width: 480px;">
                    Para acceder a tu historial completo de compras, seguimiento y comprobantes, ingresá con tu cuenta registrada de Narcisa Estudio.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="login?ReturnUrl=/mis-pedidos" class="btn btn-primary px-4 py-2 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </a>
                    <a href="register" class="btn btn-outline-secondary px-4 py-2">
                        Registrarse
                    </a>
                </div>
            </div>
        </div>
    }
    else if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border" style="color: var(--brand-peach);" role="status"></div>
            <p class="mt-3 text-muted small">Cargando tu historial de compras...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger border-0 rounded-3 shadow-sm my-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
            <button class="btn btn-link btn-sm ms-2 text-danger fw-bold" @onclick="CargarHistorial">Reintentar</button>
        </div>
    }
    else if (pedidos == null || !pedidos.Any())
    {
        <!-- Estado Vacío Boutique -->
        <div class="card border-0 shadow-sm text-center p-5 my-4" 
             style="background: linear-gradient(135deg, #fdfbf7 0%, #fdf8f4 100%); border: 1px solid #f0e6dc !important;">
            <div class="card-body py-4">
                <span class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
                      style="width: 72px; height: 72px; background-color: var(--brand-peach-light); color: var(--brand-peach);">
                    <i class="bi bi-bag-heart fs-2"></i>
                </span>
                <h3 class="h4 fw-bold font-serif mb-2" style="color: var(--brand-text-dark);">Todavía no realizaste ningún pedido</h3>
                <p class="text-muted small mx-auto mb-4" style="max-width: 460px;">
                    Explorá nuestro catálogo de mobiliario, iluminación y objetos decorativos diseñados para transformar cada rincón de tu hogar.
                </p>
                <a href="" class="btn btn-primary px-4 py-2 shadow-sm">
                    <i class="bi bi-grid-fill me-1"></i> Explorar Catálogo
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Listado de Pedidos -->
        <div class="d-flex flex-column gap-4">
            @foreach (var pedido in pedidos)
            {
                <div class="card border-0 shadow-sm overflow-hidden" style="border: 1px solid #ebdccd !important;">
                    <!-- Cabecera de la orden -->
                    <div class="card-header bg-white p-3 p-md-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2" 
                         style="border-color: #f0e6dc !important;">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-bold font-serif fs-5" style="color: var(--brand-text-dark);">
                                    Pedido #@pedido.Id
                                </span>
                                @switch (pedido.Estado)
                                {
                                    case "Pagado":
                                        <span class="badge rounded-pill px-3 py-1" 
                                              style="background-color: #eaf5ec; color: #2b7a3e; border: 1px solid #c9e6ce; font-weight: 600;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Pagado
                                        </span>
                                        break;
                                    case "Pendiente de pago":
                                        <span class="badge rounded-pill px-3 py-1" 
                                              style="background-color: #fff4e5; color: #b76e00; border: 1px solid #fed7aa; font-weight: 600;">
                                            <i class="bi bi-clock-fill me-1"></i> Pendiente de pago
                                        </span>
                                        break;
                                    case "Enviado":
                                        <span class="badge rounded-pill px-3 py-1" 
                                              style="background-color: #e8f4fd; color: #1e70a0; border: 1px solid #bae6fd; font-weight: 600;">
                                            <i class="bi bi-truck me-1"></i> Enviado
                                        </span>
                                        break;
                                    case "Entregado":
                                        <span class="badge rounded-pill px-3 py-1" 
                                              style="background-color: #f3e8ff; color: #6b21a8; border: 1px solid #d8b4fe; font-weight: 600;">
                                            <i class="bi bi-house-check-fill me-1"></i> Entregado
                                        </span>
                                        break;
                                    default:
                                        <span class="badge rounded-pill px-3 py-1 bg-secondary">
                                            @pedido.Estado
                                        </span>
                                        break;
                                }
                            </div>
                            <div class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i> @pedido.CreatedAt.ToString("dd/MM/yyyy HH:mm") hs
                            </div>
                        </div>

                        <div class="text-md-end">
                            <div class="small text-muted">Total abonado</div>
                            <div class="fs-4 fw-bold" style="color: var(--brand-peach);">
                                $@pedido.Total.ToString("N0")
                            </div>
                        </div>
                    </div>

                    <!-- Cuerpo de la orden: Dirección y Productos -->
                    <div class="card-body p-3 p-md-4">
                        @if (!string.IsNullOrWhiteSpace(pedido.Direccion))
                        {
                            <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom text-muted small" 
                                 style="border-color: #f7eee4 !important;">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                                <span><strong>Dirección de entrega:</strong> @pedido.Direccion</span>
                            </div>
                        }

                        <div class="small fw-semibold text-muted mb-2 text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                            Artículos incluidos (@pedido.Items.Count)
                        </div>

                        <div class="list-group list-group-flush border-0">
                            @foreach (var item in pedido.Items)
                            {
                                <div class="list-group-item px-0 py-2 border-0 d-flex align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" alt="@item.ProductoNombre" 
                                                 class="rounded-3 shadow-sm border" 
                                                 style="width: 52px; height: 52px; object-fit: cover; border-color: #f0e6dc !important;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-3 d-flex align-items-center justify-content-center bg-light border text-muted" 
                                                 style="width: 52px; height: 52px;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold text-dark small">@item.ProductoNombre</div>
                                            <div class="text-muted" style="font-size: 0.78rem;">
                                                Cantidad: <strong class="text-dark">@item.Cantidad</strong> &times; $@item.PrecioUnitario.ToString("N0")
                                            </div>
                                        </div>
                                    </div>
                                    <div class="fw-bold small text-dark">
                                        $@item.Subtotal.ToString("N0")
                                    </div>
                                </div>
                            }
                        </div>

                        @if (pedido.Pago != null)
                        {
                            <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between small text-muted flex-wrap gap-2"
                                 style="border-color: #f7eee4 !important; font-size: 0.8rem;">
                                <span>
                                    <i class="bi bi-credit-card me-1 text-secondary"></i>
                                    Método: <strong>@pedido.Pago.Metodo</strong>
                                </span>
                                @if (!string.IsNullOrEmpty(pedido.Pago.Referencia))
                                {
                                    <span class="text-truncate" style="max-width: 250px;">
                                        Ref: <code class="text-dark">@pedido.Pago.Referencia</code>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- Pie de la orden con Acciones -->
                    <div class="card-footer bg-light p-3 px-md-4 border-top d-flex align-items-center justify-content-between flex-wrap gap-2"
                         style="border-color: #f0e6dc !important;">
                        <div>
                            <span class="text-muted small">Estado de la transacción:</span>
                            <span class="fw-semibold small ms-1 text-dark">@pedido.Estado</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <a href="pedido-confirmado/@pedido.Id" class="btn btn-outline-dark btn-sm shadow-sm px-3">
                                <i class="bi bi-receipt me-1"></i> Ver Comprobante
                            </a>

                            @if (pedido.Estado == "Pendiente de pago")
                            {
                                <a href="pago/@pedido.Id" class="btn btn-primary btn-sm shadow-sm px-3">
                                    <i class="bi bi-credit-card-fill me-1"></i> Completar Pago
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PedidoDTO> pedidos = new();
    private bool cargando = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleAuthStateChange;

        if (AuthState.EstaAutenticado)
        {
            await CargarHistorial();
        }
        else
        {
            cargando = false;
        }
    }

    private async void HandleAuthStateChange()
    {
        if (AuthState.EstaAutenticado)
        {
            await CargarHistorial();
        }
        else
        {
            pedidos.Clear();
            cargando = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarHistorial()
    {
        if (AuthState.UsuarioActual == null)
        {
            cargando = false;
            return;
        }

        cargando = true;
        mensajeError = null;

        try
        {
            var url = $"api/pedido/usuario/{AuthState.UsuarioActual.Id}/historial";
            var resp = await Http.GetAsync<List<PedidoDTO>>(url);

            if (resp.Error || resp.Respuesta == null)
            {
                mensajeError = resp.Mensaje ?? "No se pudo recuperar el historial de compras.";
            }
            else
            {
                pedidos = resp.Respuesta;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar pedidos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= HandleAuthStateChange;
    }
}
