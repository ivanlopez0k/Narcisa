@page "/carrito"
@inject CarritoStateService CarritoState
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Carrito de Compras — Narcisa Estudio</PageTitle>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="">Catálogo</a></li>
            <li class="breadcrumb-item active" aria-current="page">Carrito de Compras</li>
        </ol>
    </nav>
    <h1 class="h2 fw-bold text-dark">Tu Carrito de Compras</h1>
    <p class="text-muted">Revisá los productos elegidos antes de ingresar la dirección de entrega.</p>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (CarritoState.CarritoActual == null || CarritoState.CarritoActual.Items.Count == 0)
{
    <div class="card border-0 shadow-sm text-center py-5 my-4 bg-light">
        <div class="card-body">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h3 class="fw-bold mt-3 text-dark">Tu carrito está vacío</h3>
            <p class="text-muted">Todavía no agregaste ningún producto decorativo de Narcisa Estudio.</p>
            <a href="" class="btn btn-dark px-4 py-2 mt-2">
                <i class="bi bi-arrow-left me-2"></i> Ver Catálogo de Productos
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Lista de Productos en el Carrito -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Productos (@CarritoState.CantidadTotalItems)</span>
                    <span class="badge bg-light text-dark border">Estado: Carrito</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th scope="col" class="ps-3">Producto</th>
                                    <th scope="col" class="text-center">Precio</th>
                                    <th scope="col" class="text-center" style="width: 140px;">Cantidad</th>
                                    <th scope="col" class="text-end">Subtotal</th>
                                    <th scope="col" class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CarritoState.CarritoActual.Items)
                                {
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="bg-light rounded p-2 text-center" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-box-seam fs-4 text-secondary"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-semibold text-dark">@item.ProductoNombre</h6>
                                                    <span class="small text-muted">Código: #@item.ProductoId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-medium">
                                            $@item.PrecioUnitario.ToString("N0")
                                        </td>
                                        <td class="text-center">
                                            <div class="input-group input-group-sm">
                                                <button class="btn btn-outline-secondary" type="button" 
                                                        disabled="@procesando"
                                                        @onclick="() => ModificarCantidad(item.ProductoId, item.Cantidad - 1)">-</button>
                                                <input type="text" class="form-control text-center" readonly value="@item.Cantidad" />
                                                <button class="btn btn-outline-secondary" type="button" 
                                                        disabled="@procesando"
                                                        @onclick="() => ModificarCantidad(item.ProductoId, item.Cantidad + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            $@item.Subtotal.ToString("N0")
                                        </td>
                                        <td class="text-center pe-3">
                                            <button class="btn btn-link text-danger p-0" title="Eliminar ítem"
                                                    disabled="@procesando"
                                                    @onclick="() => EliminarItem(item.ProductoId)">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between">
                    <a href="" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Seguir comprando
                    </a>
                </div>
            </div>
        </div>

        <!-- Resumen del Pedido -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 2rem;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">Resumen del Pedido</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal productos</span>
                        <span class="fw-semibold">$@CarritoState.CarritoActual.Total.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Cálculo de envío</span>
                        <span class="text-success fw-semibold">A convenir</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Total</span>
                        <span class="fs-4 fw-bold text-dark">$@CarritoState.CarritoActual.Total.ToString("N0")</span>
                    </div>

                    <a href="checkout" class="btn btn-dark w-100 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                        <span>Iniciar Entrega y Checkout</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <div class="mt-3 p-3 bg-light rounded text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        <span>El pedido se reservará en estado pendiente de pago para su procesamiento posterior.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool procesando = false;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        CarritoState.OnChange += StateHasChanged;
        await CarritoState.InicializarAsync();
    }

    private async Task ModificarCantidad(int productoId, int nuevaCantidad)
    {
        procesando = true;
        mensajeError = null;
        var (exito, error) = await CarritoState.ActualizarCantidadAsync(productoId, nuevaCantidad);
        if (!exito)
        {
            mensajeError = error;
        }
        procesando = false;
    }

    private async Task EliminarItem(int productoId)
    {
        procesando = true;
        mensajeError = null;
        var (exito, error) = await CarritoState.EliminarItemAsync(productoId);
        if (!exito)
        {
            mensajeError = error;
        }
        procesando = false;
    }

    public void Dispose()
    {
        CarritoState.OnChange -= StateHasChanged;
    }
}
