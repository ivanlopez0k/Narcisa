@page "/checkout"
@inject CarritoStateService CarritoState
@inject AuthStateService AuthState
@inject IHttpService Http
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Confirmar Entrega — Narcisa Estudio</PageTitle>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="">Catálogo</a></li>
            <li class="breadcrumb-item"><a href="carrito">Carrito</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">Datos de Entrega</li>
        </ol>
    </nav>
    <h1 class="h2 fw-bold font-serif mb-1" style="color: var(--brand-text-dark);">Confirmación de Pedido</h1>
    <p class="text-muted small">Indicá la dirección de entrega para reservar tu pedido en Narcisa Estudio.</p>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
    </div>
}

@if (CarritoState.CarritoActual == null || CarritoState.CarritoActual.Items.Count == 0)
{
    <div class="card text-center py-5 bg-white border">
        <div class="card-body">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                 style="width: 80px; height: 80px; background-color: var(--brand-peach-light); color: var(--brand-peach);">
                <i class="bi bi-cart-x fs-1"></i>
            </div>
            <h4 class="fw-bold font-serif mt-2" style="color: var(--brand-text-dark);">No hay piezas en tu carrito</h4>
            <p class="text-muted small">Seleccioná productos de nuestra tienda antes de proceder a la entrega.</p>
            <a href="" class="btn btn-primary px-4 py-2 mt-2">Ir al Catálogo</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Formulario de Entrega -->
        <div class="col-lg-7">
            <div class="card mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 font-serif" style="color: var(--brand-text-dark);">
                        <i class="bi bi-geo-alt me-2" style="color: var(--brand-peach);"></i> 1. Domicilio de Entrega
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (AuthState.EstaAutenticado)
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-semibold">Titular del pedido</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="bi bi-person-check-fill" style="color: var(--brand-peach);"></i>
                                </span>
                                <input type="text" class="form-control bg-light border-start-0" 
                                       value="@AuthState.UsuarioActual!.Nombre (@AuthState.UsuarioActual!.Email)" disabled readonly />
                            </div>
                            <div class="form-text small text-muted">Sesión activa como @(AuthState.UsuarioActual!.Rol ?? "Cliente").</div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 rounded-3 shadow-sm d-flex flex-column flex-sm-row align-items-sm-center justify-content-between p-3 mb-4 gap-3" 
                             style="background-color: #fef8f3; border-left: 4px solid var(--brand-peach) !important;">
                            <div class="d-flex align-items-center gap-3">
                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center p-2" 
                                      style="background-color: var(--brand-peach-light); color: var(--brand-peach); flex-shrink: 0;">
                                    <i class="bi bi-person-exclamation fs-5"></i>
                                </span>
                                <div>
                                    <div class="fw-bold text-dark small">No has iniciado sesión</div>
                                    <div class="small text-muted">Iniciá sesión para vincular este pedido a tu cuenta personal.</div>
                                </div>
                            </div>
                            <a href="login?returnUrl=checkout" class="btn btn-sm btn-primary px-3 py-2 text-nowrap">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                            </a>
                        </div>
                    }

                    <EditForm Model="@confirmarDto" OnValidSubmit="ConfirmarPedido">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="color: var(--brand-text-dark);">Dirección de Entrega (*)</label>
                            <InputText @bind-Value="confirmarDto.Direccion" class="form-control" 
                                       placeholder="Ej: Av. Alvear 1850, Piso 4 A, Recoleta" />
                            <ValidationMessage For="@(() => confirmarDto.Direccion)" class="text-danger small mt-1" />
                            <div class="form-text small text-muted">Calle, altura, piso/departamento y localidad.</div>
                        </div>

                        <div class="p-3 rounded-3 mb-4" style="background-color: var(--brand-peach-light); border: 1px solid var(--brand-peach-soft);">
                            <h6 class="fw-bold mb-1" style="color: var(--brand-peach);">
                                <i class="bi bi-info-circle me-1"></i> Entrega 2 — Caso de Uso CU-01
                            </h6>
                            <p class="small mb-0" style="color: var(--brand-text-dark);">
                                Al confirmar, el sistema registra el pedido en base de datos con estado 
                                <strong>Pendiente de pago</strong>, descuenta stock de los productos y lo deja preparado para la pasarela de pago (CU-02).
                            </p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a href="carrito" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Modificar Carrito
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-3 fw-semibold d-flex align-items-center gap-2 shadow-sm" 
                                    disabled="@procesando">
                                @if (procesando)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                    <span>Confirmando Pedido...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2-circle fs-5"></i>
                                    <span>Confirmar y Reservar Pedido</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <!-- Resumen del Carrito con fotos -->
        <div class="col-lg-5">
            <div class="card sticky-top" style="top: 2rem;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 font-serif" style="color: var(--brand-text-dark);">Resumen de Compra</h5>
                    <span class="badge bg-warning rounded-pill px-2 py-1">Orden #@CarritoState.CarritoActual.Id</span>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in CarritoState.CarritoActual.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded overflow-hidden shadow-sm text-center" 
                                         style="width: 48px; height: 48px; background-color: #f7efe7; flex-shrink: 0;">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" class="w-100 h-100" style="object-fit: cover;" alt="@item.ProductoNombre" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image fs-5 text-muted"></i>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="my-0 fw-semibold" style="color: var(--brand-text-dark); font-size: 0.95rem;">@item.ProductoNombre</h6>
                                        <small class="text-muted">@item.Cantidad u. x $@item.PrecioUnitario.ToString("N0")</small>
                                    </div>
                                </div>
                                <span class="fw-bold font-serif" style="color: var(--brand-peach);">$@item.Subtotal.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white p-4 border-top">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Subtotal</span>
                        <span class="fw-semibold">$@CarritoState.CarritoActual.Total.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Envío</span>
                        <span class="text-success small fw-semibold">Gratis</span>
                    </div>
                    <hr class="my-3" style="border-color: #ebdccd;" />
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fs-5 fw-bold font-serif" style="color: var(--brand-text-dark);">Total a Pagar</span>
                        <span class="fs-3 fw-bold font-serif" style="color: var(--brand-peach);">$@CarritoState.CarritoActual.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ConfirmarPedidoDTO confirmarDto = new();
    private bool procesando = false;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += StateHasChanged;
        CarritoState.OnChange += StateHasChanged;
        await CarritoState.InicializarAsync();
        if (CarritoState.CarritoActual != null && !string.IsNullOrEmpty(CarritoState.CarritoActual.Direccion))
        {
            confirmarDto.Direccion = CarritoState.CarritoActual.Direccion;
        }
    }

    private async Task ConfirmarPedido()
    {
        if (CarritoState.CarritoActual == null) return;

        if (!AuthState.EstaAutenticado)
        {
            mensajeError = "Por favor iniciá sesión antes de confirmar tu pedido.";
            return;
        }

        procesando = true;
        mensajeError = null;

        int pedidoId = CarritoState.CarritoActual.Id;

        // 1. Guardar dirección
        var dirResp = await Http.PutAsync<ConfirmarPedidoDTO, PedidoDTO>($"api/pedido/{pedidoId}/direccion", confirmarDto);
        if (dirResp.Error)
        {
            mensajeError = dirResp.Mensaje ?? "No se pudo registrar la dirección de entrega.";
            procesando = false;
            return;
        }

        // 2. Confirmar pedido (pasa a Pendiente de pago y descuenta stock)
        var confResp = await Http.PostAsync<object?, PedidoDTO>($"api/pedido/{pedidoId}/confirmar", null);
        if (confResp.Error || confResp.Respuesta == null)
        {
            mensajeError = confResp.Mensaje ?? "No se pudo confirmar el pedido.";
            procesando = false;
            return;
        }

        // 3. Limpiar estado local del carrito y navegar a confirmación
        CarritoState.LimpiarCarritoLocal();
        procesando = false;
        Nav.NavigateTo($"pedido-confirmado/{pedidoId}");
    }

    public void Dispose()
    {
        AuthState.OnChange -= StateHasChanged;
        CarritoState.OnChange -= StateHasChanged;
    }
}
