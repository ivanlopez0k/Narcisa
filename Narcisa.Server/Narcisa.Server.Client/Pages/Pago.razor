@page "/pago/{Id:int}"
@inject IHttpService Http
@inject NavigationManager Nav
@inject CarritoStateService CarritoState
@inject AuthStateService AuthState

<PageTitle>Pasarela de Pago — Narcisa Estudio</PageTitle>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="">Catálogo</a></li>
            <li class="breadcrumb-item"><a href="carrito">Carrito</a></li>
            <li class="breadcrumb-item"><a href="checkout">Entrega</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">Pago</li>
        </ol>
    </nav>
    <h1 class="h2 fw-bold font-serif mb-1" style="color: var(--brand-text-dark);">Pasarela de Pago</h1>
    <p class="text-muted small">Completá los datos de pago para confirmar y abonar tu pedido en Narcisa Estudio.</p>
</div>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" style="color: var(--brand-peach);" role="status"></div>
        <p class="mt-3 text-muted">Cargando datos del pedido...</p>
    </div>
}
else if (pedido == null)
{
    <div class="card text-center my-5 p-5 bg-white border">
        <div class="card-body">
            <i class="bi bi-exclamation-circle display-4" style="color: var(--brand-peach);"></i>
            <h4 class="mt-3 fw-bold font-serif" style="color: var(--brand-text-dark);">Pedido no encontrado</h4>
            <p class="text-muted small">No se encontró la información del pedido #@Id.</p>
            <a href="" class="btn btn-primary mt-2">Volver a la Tienda</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Formulario y Tarjeta Interactiva -->
        <div class="col-lg-7">
            <!-- Pestañas / Selector de Método -->
            <div class="card mb-4 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 font-serif" style="color: var(--brand-text-dark);">
                        <i class="bi bi-credit-card-2-front me-2" style="color: var(--brand-peach);"></i> Método de Pago
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex gap-2 mb-4 flex-wrap">
                        <button type="button" 
                                class="btn @(metodoSeleccionado == "Tarjeta de Crédito / Débito" ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-2 px-3 py-2"
                                @onclick='() => SeleccionarMetodo("Tarjeta de Crédito / Débito")'>
                            <i class="bi bi-credit-card"></i>
                            <span>Tarjeta de Crédito / Débito</span>
                        </button>
                        <button type="button" 
                                class="btn @(metodoSeleccionado == "Transferencia Bancaria" ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-2 px-3 py-2"
                                @onclick='() => SeleccionarMetodo("Transferencia Bancaria")'>
                            <i class="bi bi-bank"></i>
                            <span>Transferencia Bancaria</span>
                        </button>
                    </div>

                    @if (metodoSeleccionado == "Tarjeta de Crédito / Débito")
                    {
                        <!-- Visual Card Preview -->
                        <div class="rounded-4 p-4 mb-4 text-white position-relative shadow" 
                             style="background: linear-gradient(135deg, #2c2523 0%, #4a3e39 65%, #e76f51 100%); min-height: 190px;">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="small text-uppercase tracking-wider opacity-75 font-serif">Narcisa Estudio</span>
                                <i class="bi bi-wifi fs-4 opacity-75"></i>
                            </div>
                            <div class="mb-4">
                                <div class="rounded bg-warning bg-opacity-75 mb-3" style="width: 40px; height: 28px; border-radius: 4px;"></div>
                                <div class="font-monospace fs-5 letter-spacing-2">
                                    @(string.IsNullOrWhiteSpace(pagoDto.NumeroTarjeta) ? "•••• •••• •••• ••••" : FormatearTarjeta(pagoDto.NumeroTarjeta))
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-end text-uppercase small">
                                <div>
                                    <div class="opacity-50" style="font-size: 0.7rem;">Titular</div>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(pagoDto.NombreTitular) ? "NOMBRE APELLIDO" : pagoDto.NombreTitular)</div>
                                </div>
                                <div class="text-end">
                                    <div class="opacity-50" style="font-size: 0.7rem;">Vence</div>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(pagoDto.Vencimiento) ? "MM/AA" : pagoDto.Vencimiento)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Botón de Simulación de datos -->
                        <div class="d-flex justify-content-end mb-3">
                            <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm"
                                    @onclick="AutoRellenarPrueba">
                                <i class="bi bi-magic"></i>
                                <span>Rellenar datos de prueba (Simulación)</span>
                            </button>
                        </div>

                        <EditForm Model="@pagoDto" OnValidSubmit="RealizarPago">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-text-dark);">Número de Tarjeta (*)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-credit-card" style="color: var(--brand-peach);"></i>
                                    </span>
                                    <InputText @bind-Value="pagoDto.NumeroTarjeta" class="form-control border-start-0" 
                                               placeholder="4509 1234 5678 9010" maxlength="19" />
                                </div>
                                <ValidationMessage For="@(() => pagoDto.NumeroTarjeta)" class="text-danger small mt-1" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-text-dark);">Nombre del Titular (*)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="bi bi-person" style="color: var(--brand-peach);"></i>
                                    </span>
                                    <InputText @bind-Value="pagoDto.NombreTitular" class="form-control border-start-0 text-uppercase" 
                                               placeholder="Como figura en la tarjeta" />
                                </div>
                                <ValidationMessage For="@(() => pagoDto.NombreTitular)" class="text-danger small mt-1" />
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <label class="form-label fw-semibold" style="color: var(--brand-text-dark);">Vencimiento (*)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted">
                                            <i class="bi bi-calendar-event" style="color: var(--brand-peach);"></i>
                                        </span>
                                        <InputText @bind-Value="pagoDto.Vencimiento" class="form-control border-start-0" 
                                                   placeholder="MM/AA" maxlength="5" />
                                    </div>
                                    <ValidationMessage For="@(() => pagoDto.Vencimiento)" class="text-danger small mt-1" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold" style="color: var(--brand-text-dark);">Código CVV (*)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white border-end-0 text-muted">
                                            <i class="bi bi-shield-lock" style="color: var(--brand-peach);"></i>
                                        </span>
                                        <InputText @bind-Value="pagoDto.Cvv" class="form-control border-start-0" 
                                                   placeholder="789" maxlength="4" />
                                    </div>
                                    <ValidationMessage For="@(() => pagoDto.Cvv)" class="text-danger small mt-1" />
                                </div>
                            </div>

                            <!-- Informative badge / card -->
                            <div class="p-3 rounded-3 mb-4" style="background-color: var(--brand-peach-light); border: 1px solid var(--brand-peach-soft);">
                                <h6 class="fw-bold mb-1" style="color: var(--brand-peach);">
                                    <i class="bi bi-shield-check me-1"></i> Simulación de Pasarela de Pago (CU-02)
                                </h6>
                                <p class="small mb-0" style="color: var(--brand-text-dark);">
                                    Al confirmar, la transacción se aprueba inmediatamente y el pedido pasa a estado <strong>Pagado</strong> con generación de comprobante de pago.
                                </p>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <a href="checkout" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i> Volver a Entrega
                                </a>
                                <button type="submit" class="btn btn-primary px-4 py-3 fw-semibold d-flex align-items-center gap-2 shadow-sm" 
                                        disabled="@procesando">
                                    @if (procesando)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        <span>Procesando Pago...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-lock-fill"></i>
                                        <span>Pagar $@pedido.Total.ToString("N0")</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <!-- Transferencia Bancaria -->
                        <div class="p-4 rounded-3 mb-4 bg-light border">
                            <h6 class="fw-bold mb-3 font-serif" style="color: var(--brand-text-dark);">
                                <i class="bi bi-bank2 me-2" style="color: var(--brand-peach);"></i> Datos Bancarios para Transferencia
                            </h6>
                            <ul class="list-unstyled small mb-3 d-flex flex-column gap-2 text-muted">
                                <li><strong class="text-dark">Banco:</strong> Banco Simulado / Mercado Pago</li>
                                <li><strong class="text-dark">Titular:</strong> Narcisa Estudio Interiorismo S.A.</li>
                                <li><strong class="text-dark">CUIT:</strong> 30-71234567-8</li>
                                <li><strong class="text-dark">Alias:</strong> <span class="badge bg-light text-dark border px-2 py-1">NARCISA.ESTUDIO.SIM</span></li>
                                <li><strong class="text-dark">CBU:</strong> <code class="text-dark">0000003100012345678901</code></li>
                            </ul>
                            <div class="p-3 rounded-3" style="background-color: var(--brand-peach-light); border: 1px solid var(--brand-peach-soft);">
                                <p class="small mb-0" style="color: var(--brand-text-dark);">
                                    <i class="bi bi-info-circle me-1" style="color: var(--brand-peach);"></i>
                                    Para fines de la simulación (CU-02), podés confirmar la transferencia directamente haciendo clic en el botón inferior para aprobar el pago.
                                </p>
                            </div>
                        </div>

                        <EditForm Model="@pagoDto" OnValidSubmit="RealizarPago">
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <a href="checkout" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-1"></i> Volver a Entrega
                                </a>
                                <button type="submit" class="btn btn-primary px-4 py-3 fw-semibold d-flex align-items-center gap-2 shadow-sm" 
                                        disabled="@procesando">
                                    @if (procesando)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        <span>Confirmando Transferencia...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>Confirmar Transferencia $@pedido.Total.ToString("N0")</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>

        <!-- Resumen del Pedido y Entrega -->
        <div class="col-lg-5">
            <div class="card sticky-top" style="top: 2rem;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 font-serif" style="color: var(--brand-text-dark);">Resumen del Pedido</h5>
                    <span class="badge bg-warning rounded-pill px-2 py-1">Orden #@pedido.Id</span>
                </div>
                <div class="card-body p-4 border-bottom">
                    <div class="mb-3">
                        <span class="text-muted small d-block">Dirección de Entrega:</span>
                        <div class="fw-semibold" style="color: var(--brand-text-dark);">
                            <i class="bi bi-geo-alt me-1" style="color: var(--brand-peach);"></i> @pedido.Direccion
                        </div>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Estado actual:</span>
                        <span class="badge bg-warning text-dark rounded-pill">@pedido.Estado</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in pedido.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded overflow-hidden shadow-sm text-center" 
                                         style="width: 44px; height: 44px; background-color: #f7efe7; flex-shrink: 0;">
                                        @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                        {
                                            <img src="@item.ImagenUrl" class="w-100 h-100" style="object-fit: cover;" alt="@item.ProductoNombre" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image fs-5 text-muted"></i>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="my-0 fw-semibold" style="color: var(--brand-text-dark); font-size: 0.9rem;">@item.ProductoNombre</h6>
                                        <small class="text-muted">@item.Cantidad u. x $@item.PrecioUnitario.ToString("N0")</small>
                                    </div>
                                </div>
                                <span class="fw-bold font-serif" style="color: var(--brand-peach);">$@item.Subtotal.ToString("N0")</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white p-4 border-top">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Subtotal</span>
                        <span class="fw-semibold">$@pedido.Total.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Envío</span>
                        <span class="text-success small fw-semibold">Gratis</span>
                    </div>
                    <hr class="my-3" style="border-color: #ebdccd;" />
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fs-5 fw-bold font-serif" style="color: var(--brand-text-dark);">Total a Pagar</span>
                        <span class="fs-3 fw-bold font-serif" style="color: var(--brand-peach);">$@pedido.Total.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PedidoDTO? pedido;
    private ProcesarPagoDTO pagoDto = new();
    private bool cargando = true;
    private bool procesando = false;
    private string? mensajeError;
    private string metodoSeleccionado = "Tarjeta de Crédito / Débito";

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        pagoDto.PedidoId = Id;
        pagoDto.Metodo = "Tarjeta de Crédito";

        var resp = await Http.GetAsync<PedidoDTO>($"api/pedido/{Id}");
        if (!resp.Error && resp.Respuesta != null)
        {
            pedido = resp.Respuesta;
            if (pedido.Estado == "Pagado")
            {
                Nav.NavigateTo($"pedido-confirmado/{Id}");
                return;
            }
        }
        else
        {
            mensajeError = resp.Mensaje ?? "No se pudo recuperar la información del pedido.";
        }

        cargando = false;
    }

    private void SeleccionarMetodo(string metodo)
    {
        metodoSeleccionado = metodo;
        if (metodo == "Transferencia Bancaria")
        {
            pagoDto.Metodo = "Transferencia Bancaria";
            pagoDto.NumeroTarjeta = "CBU-0000003100012345678901";
            pagoDto.NombreTitular = AuthState.UsuarioActual?.Nombre ?? "MARIA LOPEZ";
            pagoDto.Vencimiento = "12/99";
            pagoDto.Cvv = "000";
        }
        else
        {
            pagoDto.Metodo = "Tarjeta de Crédito";
            pagoDto.NumeroTarjeta = "";
            pagoDto.NombreTitular = "";
            pagoDto.Vencimiento = "";
            pagoDto.Cvv = "";
        }
    }

    private void AutoRellenarPrueba()
    {
        pagoDto.Metodo = "Tarjeta de Crédito";
        pagoDto.NumeroTarjeta = "4509 1234 5678 9010";
        pagoDto.NombreTitular = "MARIA LOPEZ";
        pagoDto.Vencimiento = "08/29";
        pagoDto.Cvv = "789";
        metodoSeleccionado = "Tarjeta de Crédito / Débito";
        mensajeError = null;
    }

    private string FormatearTarjeta(string numero)
    {
        var digitos = new string(numero.Where(char.IsDigit).ToArray());
        var grupos = new List<string>();
        for (int i = 0; i < digitos.Length; i += 4)
        {
            grupos.Add(digitos.Substring(i, Math.Min(4, digitos.Length - i)));
        }
        return string.Join(" ", grupos);
    }

    private async Task RealizarPago()
    {
        if (pedido == null || procesando) return;

        procesando = true;
        mensajeError = null;

        pagoDto.PedidoId = Id;
        var resp = await Http.PostAsync<ProcesarPagoDTO, PagoDTO>("api/pago/procesar", pagoDto);

        if (resp.Error || resp.Respuesta == null)
        {
            mensajeError = resp.Mensaje ?? "No se pudo procesar el pago. Verifique los datos e intente nuevamente.";
            procesando = false;
            return;
        }

        CarritoState.LimpiarCarritoLocal();
        procesando = false;
        Nav.NavigateTo($"pedido-confirmado/{Id}");
    }
}
