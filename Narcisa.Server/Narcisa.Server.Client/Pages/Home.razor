@page "/"
@inject IHttpService Http
@inject CarritoStateService CarritoState

<PageTitle>Narcisa Estudio — Decoración y Mobiliario</PageTitle>

<!-- Hero Section Soft / Cálido -->
<div class="p-4 p-md-5 mb-4 rounded-4 shadow-sm position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #fef4ed 0%, #fae6d8 100%); border: 1px solid #ebdccd;">
    <div class="col-md-9 px-0">
        <span class="badge bg-warning rounded-pill px-3 py-2 mb-3 text-uppercase fw-semibold" style="letter-spacing: 1px;">
            <i class="bi bi-sparkles me-1"></i> Diseño & Decoración de Interiores
        </span>
        <h1 class="display-5 fw-bold font-serif mb-2" style="color: var(--brand-text-dark);">
            Espacios que inspiran calidez
        </h1>
        <p class="lead my-2" style="color: var(--brand-text-muted); font-size: 1.15rem;">
            Descubrí nuestra cuidada selección de piezas decorativas y mobiliario para transformar cada rincón de tu hogar.
        </p>
    </div>
</div>

<!-- Header de Sección y Buscador -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="h3 fw-bold mb-1 font-serif" style="color: var(--brand-text-dark);">Catálogo Seleccionado</h2>
        <p class="text-muted mb-0 small">Explorá los productos disponibles y agregá tus favoritos al carrito.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <div class="input-group" style="max-width: 320px;">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control border-start-0" placeholder="Buscar por nombre o descripción..." 
                   @bind="filtroBusqueda" @bind:event="oninput" />
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeFeedback))
{
    <div class="alert alert-@tipoFeedback alert-dismissible fade show shadow-sm border-0" 
         style="background-color: @(tipoFeedback == "success" ? "#eaf5ec" : "#fdf0f0"); color: @(tipoFeedback == "success" ? "#2b7a3e" : "#c92a2a"); border-radius: 12px;" role="alert">
        <i class="bi @(tipoFeedback == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
        @mensajeFeedback
        <button type="button" class="btn-close" @onclick="() => mensajeFeedback = null"></button>
    </div>
}

<!-- Grilla de Productos -->
@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" style="color: var(--brand-peach);" role="status">
            <span class="visually-hidden">Cargando productos...</span>
        </div>
        <p class="mt-3 text-muted">Cargando colección de Narcisa Estudio...</p>
    </div>
}
else if (errorCarga != null)
{
    <div class="alert alert-danger rounded-3" role="alert">
        <i class="bi bi-x-circle me-2"></i> @errorCarga
        <button class="btn btn-sm btn-outline-danger ms-3" @onclick="CargarProductos">Reintentar</button>
    </div>
}
else if (ProductosFiltrados.Count == 0)
{
    <div class="text-center py-5 bg-white rounded-4 border p-4 shadow-sm">
        <i class="bi bi-box2 display-4" style="color: var(--brand-peach);"></i>
        <p class="mt-3 text-muted fs-5">No se encontraron productos con el filtro aplicado.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var prod in ProductosFiltrados)
        {
            <div class="col">
                <div class="card h-100 product-card overflow-hidden">
                    <div class="position-relative" style="height: 220px; background-color: #f7efe7;">
                        @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                        {
                            <img src="@prod.ImagenUrl" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@prod.Nombre" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-image fs-1 text-secondary opacity-50 mb-1"></i>
                                <span class="small text-muted">Narcisa Estudio</span>
                            </div>
                        }
                        <span class="position-absolute top-0 end-0 m-3 badge rounded-pill @(prod.Stock > 0 ? "bg-success" : "bg-danger")">
                            @(prod.Stock > 0 ? $"Stock: {prod.Stock}" : "Agotado")
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h5 class="card-title fw-bold font-serif mb-2" style="color: var(--brand-text-dark); font-size: 1.25rem;">
                            @prod.Nombre
                        </h5>
                        <p class="card-text text-muted small flex-grow-1" style="line-height: 1.5;">
                            @prod.Descripcion
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-baseline my-3 pt-2 border-top">
                            <span class="fs-4 fw-bold font-serif" style="color: var(--brand-peach);">$@prod.Precio.ToString("N0")</span>
                            <span class="text-muted small">Precio unitario</span>
                        </div>

                        @if (prod.Stock > 0)
                        {
                            var cantSeleccionada = ObtenerCantidad(prod.Id);
                            <div class="d-flex gap-2">
                                <div class="input-group" style="width: 105px;">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" 
                                            @onclick="() => DecrementarCantidad(prod.Id)">-</button>
                                    <input type="text" class="form-control form-control-sm text-center" 
                                           readonly value="@cantSeleccionada" />
                                    <button class="btn btn-outline-secondary btn-sm" type="button" 
                                            @onclick="() => IncrementarCantidad(prod.Id, prod.Stock)">+</button>
                                </div>
                                <button class="btn btn-primary flex-grow-1 btn-sm d-flex align-items-center justify-content-center gap-2"
                                        disabled="@agregandoId.HasValue"
                                        @onclick="() => AgregarAlCarrito(prod)">
                                    @if (agregandoId == prod.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-bag-plus"></i>
                                        <span>Agregar</span>
                                    }
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-outline-secondary w-100 btn-sm" disabled>Agotado momentáneamente</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ProductoDTO> productos = new();
    private Dictionary<int, int> cantidades = new();
    private string filtroBusqueda = "";
    private bool cargando = true;
    private string? errorCarga;
    private int? agregandoId;
    private string? mensajeFeedback;
    private string tipoFeedback = "success";

    private List<ProductoDTO> ProductosFiltrados =>
        string.IsNullOrWhiteSpace(filtroBusqueda)
            ? productos
            : productos.Where(p => p.Nombre.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                  p.Descripcion.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase))
                       .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        await CarritoState.InicializarAsync();
    }

    private async Task CargarProductos()
    {
        cargando = true;
        errorCarga = null;
        var resp = await Http.GetAsync<List<ProductoDTO>>("api/productos");
        if (resp.Error)
        {
            errorCarga = resp.Mensaje ?? "No se pudo obtener el catálogo de productos.";
        }
        else
        {
            productos = resp.Respuesta ?? new List<ProductoDTO>();
        }
        cargando = false;
    }

    private int ObtenerCantidad(int prodId)
    {
        if (!cantidades.ContainsKey(prodId))
        {
            cantidades[prodId] = 1;
        }
        return cantidades[prodId];
    }

    private void IncrementarCantidad(int prodId, int maxStock)
    {
        int actual = ObtenerCantidad(prodId);
        if (actual < maxStock)
        {
            cantidades[prodId] = actual + 1;
        }
    }

    private void DecrementarCantidad(int prodId)
    {
        int actual = ObtenerCantidad(prodId);
        if (actual > 1)
        {
            cantidades[prodId] = actual - 1;
        }
    }

    private async Task AgregarAlCarrito(ProductoDTO prod)
    {
        agregandoId = prod.Id;
        int cantidad = ObtenerCantidad(prod.Id);

        var (exito, error) = await CarritoState.AgregarProductoAsync(prod.Id, cantidad);
        if (exito)
        {
            tipoFeedback = "success";
            mensajeFeedback = $"¡Se agregaron {cantidad} unidad(es) de '{prod.Nombre}' a tu carrito!";
            cantidades[prod.Id] = 1;
        }
        else
        {
            tipoFeedback = "danger";
            mensajeFeedback = error ?? "Ocurrió un error al agregar el ítem.";
        }

        agregandoId = null;
    }
}
