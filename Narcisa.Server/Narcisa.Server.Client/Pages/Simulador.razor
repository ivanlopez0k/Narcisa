@page "/simulador"
@page "/simulador/{Id:int}"
@rendermode InteractiveAuto
@inject IHttpService HttpService
@inject HttpClient Http
@inject AuthStateService AuthState
@inject CarritoStateService CarritoState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Simulador de Espacios | Narcisa Estudio</PageTitle>

<div class="container-fluid px-lg-4 py-3">
    <!-- Top Action Bar -->
    <div class="card p-3 mb-3 border shadow-sm" style="background-color: #ffffff;">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <a href="proyectos" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1" title="Ver mis proyectos">
                    <i class="bi bi-arrow-left"></i>
                    <span class="d-none d-sm-inline">Mis Proyectos</span>
                </a>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 1px;">Proyecto:</span>
                    <input type="text" 
                           class="form-control form-control-sm fw-bold font-serif" 
                           style="max-width: 260px; font-size: 1.1rem; color: var(--brand-text-dark);" 
                           placeholder="Ej. Living Principal" 
                           @bind="nombreProyecto" />
                </div>
                @if (Id.HasValue && Id.Value > 0)
                {
                    <span class="badge bg-secondary">Editando #@Id</span>
                }
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (canvasItems.Count > 0)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarLienzo">
                        <i class="bi bi-trash me-1"></i> Vaciar Espacio
                    </button>
                }

                <button type="button" 
                        class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm" 
                        @onclick="AgregarPiezasAlCarritoAsync"
                        disabled="@(canvasItems.Count == 0 || isAddingToCart)">
                    @if (isAddingToCart)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Agregando...</span>
                    }
                    else
                    {
                        <i class="bi bi-bag-plus-fill"></i>
                        <span>Agregar piezas al Carrito (@canvasItems.Count)</span>
                    }
                </button>

                <button type="button" 
                        class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3" 
                        @onclick="GuardarProyectoAsync"
                        disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-floppy-fill"></i>
                        <span>Guardar Proyecto</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Alert / Toast Messages -->
    @if (!string.IsNullOrEmpty(toastMessage))
    {
        <div class="alert @(isErrorToast ? "alert-danger" : "alert-success") alert-dismissible fade show d-flex align-items-center gap-2 mb-3 shadow-sm" role="alert">
            <i class="bi @(isErrorToast ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div class="flex-grow-1">@toastMessage</div>
            <button type="button" class="btn-close" @onclick="() => toastMessage = null"></button>
        </div>
    }

    <!-- Ambient Selection Bar -->
    <div class="card p-3 mb-3 border shadow-sm" style="background-color: #fdfbf7;">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-house-door-fill" style="color: var(--brand-peach);"></i>
                <span class="fw-bold small text-uppercase" style="letter-spacing: 0.5px; color: var(--brand-text-dark);">
                    Seleccionar Ambiente:
                </span>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                @foreach (var amb in presetAmbientes)
                {
                    var isSelected = ambienteSeleccionadoUrl == amb.Url;
                    <button type="button" 
                            class="btn btn-sm d-flex align-items-center gap-2 p-1 pe-3 rounded-pill transition-all"
                            style="@(isSelected ? "background-color: var(--brand-peach); color: white; border: 2px solid var(--brand-peach);" : "background-color: #ffffff; color: var(--brand-text-dark); border: 1px solid #ebdccd;")"
                            @onclick="() => SeleccionarAmbiente(amb.Url)">
                        <img src="@amb.Url" 
                             alt="@amb.Nombre" 
                             class="rounded-circle object-fit-cover shadow-sm" 
                             style="width: 28px; height: 28px;" />
                        <span class="small fw-semibold">@amb.Nombre</span>
                    </button>
                }

                <!-- Subir propia foto -->
                <label for="inputAmbienteUpload" 
                       class="btn btn-sm btn-outline-secondary rounded-pill d-inline-flex align-items-center gap-2 mb-0 cursor-pointer shadow-sm" 
                       style="border-style: dashed; border-width: 1.5px;">
                    <i class="bi bi-camera-fill text-primary" style="color: var(--brand-peach) !important;"></i>
                    <span class="small">
                        @(isUploadingAmbiente ? "Subiendo espacio..." : "Subir foto de mi propio espacio")
                    </span>
                </label>
                <InputFile id="inputAmbienteUpload" 
                           OnChange="SubirAmbienteUsuario" 
                           accept="image/png, image/jpeg, image/webp" 
                           class="d-none" 
                           disabled="@isUploadingAmbiente" />
            </div>
        </div>
    </div>

    <!-- Main Workspace Layout: Canvas on Left/Center, Catalog Drawer on Right -->
    <div class="row g-3">
        <!-- Interactive Canvas Area -->
        <div class="col-12 col-xl-8">
            <div class="card p-2 border shadow-sm position-relative overflow-hidden" style="background-color: #2b2523;">
                <!-- Canvas viewport container -->
                <div id="simulator-canvas" 
                     class="simulator-canvas position-relative overflow-hidden rounded-3 shadow-inner" 
                     style="aspect-ratio: 16 / 9; width: 100%; min-height: 420px; background-color: #24201e; touch-action: none; user-select: none;"
                     @onpointermove="OnCanvasPointerMove"
                     @onpointerup="OnCanvasPointerUp"
                     @onpointercancel="OnCanvasPointerUp">
                    
                    <!-- Ambient Background Image -->
                    <img src="@ambienteSeleccionadoUrl" 
                         alt="Fondo de ambiente" 
                         class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover pe-none" 
                         onerror="this.src='/images/ambientes/living-nordico.jpg'" />

                    <!-- Optional subtle floor grid overlay indicator -->
                    <div class="position-absolute bottom-0 start-0 w-100 p-2 pe-none d-flex justify-content-between align-items-end" 
                         style="background: linear-gradient(to top, rgba(0,0,0,0.4), transparent); color: rgba(255,255,255,0.7); font-size: 0.75rem;">
                        <span><i class="bi bi-arrows-move me-1"></i> Arrastrá cualquier pieza para ubicarla en la habitación</span>
                        <span>@canvasItems.Count @(canvasItems.Count == 1 ? "pieza en el espacio" : "piezas en el espacio")</span>
                    </div>

                    <!-- Placed Products on Canvas -->
                    @foreach (var item in canvasItems)
                    {
                        var isItemActive = selectedItem?.Uid == item.Uid;
                        <div class="position-absolute cursor-grab @(isItemActive ? "active-canvas-item" : "")"
                             style="left: @(item.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; 
                                    top: @(item.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; 
                                    width: @(item.Scale)px; 
                                    transform: translate(-50%, -50%); 
                                    z-index: @(item.ZIndex);"
                             @onpointerdown="(e) => StartDragItem(item, e)"
                             @onclick:stopPropagation="true">
                            
                            <img src="@(item.ImagenPngUrl ?? item.ImagenUrl)" 
                                 alt="@item.ProductoNombre" 
                                 class="w-100 h-auto d-block pe-none filter-drop-shadow" 
                                 draggable="false" />

                            @if (isItemActive)
                            {
                                <div class="position-absolute top-0 start-50 translate-middle-x badge bg-dark text-white shadow-sm px-2 py-1" 
                                     style="font-size: 0.7rem; white-space: nowrap; margin-top: -10px; border: 1px solid var(--brand-peach); pointer-events: none;">
                                    @item.ProductoNombre
                                </div>
                            }
                        </div>
                    }

                    <!-- Canvas Empty State Hint -->
                    @if (canvasItems.Count == 0)
                    {
                        <div class="position-absolute top-50 start-50 translate-middle text-center p-4 rounded-4 shadow"
                             style="background-color: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); max-width: 380px;">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                                 style="width: 52px; height: 52px; background-color: var(--brand-peach-light); color: var(--brand-peach);">
                                <i class="bi bi-hand-index-thumb fs-3"></i>
                            </div>
                            <h5 class="font-serif fw-bold mb-1">Comenzá a diseñar</h5>
                            <p class="text-muted small mb-0">
                                Elegí piezas del catálogo en la columna derecha y hacé clic en <strong>+ Ubicar</strong> para componer tu ambiente.
                            </p>
                        </div>
                    }
                </div>

                <!-- Floating Item Controls Toolbar (Active when an item is selected) -->
                @if (selectedItem != null)
                {
                    <div class="card p-2 mt-2 border-0 shadow-sm" style="background-color: #fcf9f5;">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary" style="background-color: var(--brand-peach) !important;">Seleccionado</span>
                                <span class="fw-bold small" style="color: var(--brand-text-dark);">@selectedItem.ProductoNombre</span>
                                <span class="text-muted small">($ @selectedItem.ProductoPrecio.ToString("N0"))</span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <!-- Scale Controls -->
                                <div class="d-flex align-items-center gap-1">
                                    <span class="text-muted small me-1">Tamaño:</span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0" @onclick="() => AjustarEscala(selectedItem, -15)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <input type="range" 
                                           class="form-range" 
                                           style="width: 110px;" 
                                           min="60" 
                                           max="320" 
                                           step="5" 
                                           @bind="selectedItem.Scale" 
                                           @bind:event="oninput" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0" @onclick="() => AjustarEscala(selectedItem, 15)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                    <span class="small text-muted font-monospace" style="min-width: 45px;">@(selectedItem.Scale)px</span>
                                </div>

                                <!-- Layer controls -->
                                <button type="button" 
                                        class="btn btn-outline-secondary btn-sm" 
                                        title="Traer al frente" 
                                        @onclick="() => TraerAlFrente(selectedItem)">
                                    <i class="bi bi-layers-fill"></i>
                                </button>

                                <!-- Delete from canvas -->
                                <button type="button" 
                                        class="btn btn-outline-danger btn-sm" 
                                        title="Quitar esta pieza del espacio" 
                                        @onclick="() => EliminarItemDelLienzo(selectedItem)">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Product Catalog Sidebar -->
        <div class="col-12 col-xl-4">
            <div class="card p-3 border shadow-sm h-100" style="background-color: #ffffff;">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom">
                    <div>
                        <h5 class="font-serif fw-bold mb-0" style="color: var(--brand-text-dark);">
                            Catálogo de Piezas
                        </h5>
                        <div class="text-muted small">Colección Narcisa Estudio</div>
                    </div>
                    <span class="badge bg-warning rounded-pill px-2 py-1">
                        @catalogoProductos.Count disponibles
                    </span>
                </div>

                @if (isLoadingProductos)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <div class="small text-muted mt-2">Cargando catálogo...</div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 overflow-y-auto pe-1" style="max-height: 580px;">
                        @foreach (var prod in catalogoProductos)
                        {
                            <div class="p-2 rounded-3 border d-flex align-items-center justify-content-between gap-3 hover-shadow transition-all"
                                 style="background-color: #fdfbf7;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 p-1 d-flex align-items-center justify-content-center shadow-sm" 
                                         style="width: 58px; height: 58px; background-color: #ffffff; border: 1px solid #ebdccd;">
                                        <img src="@(prod.ImagenPngUrl ?? prod.ImagenUrl)" 
                                             alt="@prod.Nombre" 
                                             class="w-100 h-100 object-fit-contain" />
                                    </div>
                                    <div>
                                        <div class="fw-semibold small text-truncate" style="max-width: 170px; color: var(--brand-text-dark);" title="@prod.Nombre">
                                            @prod.Nombre
                                        </div>
                                        <div class="fw-bold small" style="color: var(--brand-peach);">
                                            $ @prod.Precio.ToString("N0")
                                        </div>
                                        <div class="text-muted" style="font-size: 0.72rem;">
                                            @(prod.Stock > 0 ? "En stock" : "Bajo pedido")
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <button type="button" 
                                            class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm px-2 py-1"
                                            title="Ubicar esta pieza en el espacio"
                                            @onclick="() => AgregarProductoAlLienzo(prod)">
                                        <i class="bi bi-plus-lg"></i>
                                        <span class="small fw-semibold">Ubicar</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .cursor-grab {
        cursor: grab;
    }
    .cursor-grab:active {
        cursor: grabbing;
    }
    .filter-drop-shadow {
        filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
    }
    .active-canvas-item {
        outline: 2px dashed var(--brand-peach);
        outline-offset: 4px;
        border-radius: 8px;
    }
    .shadow-inner {
        box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.4);
    }
    .transition-all {
        transition: all 0.2s ease;
    }
    .hover-shadow:hover {
        background-color: #faeee5 !important;
        border-color: var(--brand-peach-soft) !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    [Parameter]
    public int? Id { get; set; }

    private string nombreProyecto = "Living Principal";
    private string ambienteSeleccionadoUrl = "/images/ambientes/living-nordico.jpg";
    private List<ProductoDTO> catalogoProductos = new();
    private List<CanvasItem> canvasItems = new();
    private CanvasItem? selectedItem;

    private bool isLoadingProductos = true;
    private bool isSaving = false;
    private bool isAddingToCart = false;
    private bool isUploadingAmbiente = false;

    private string? toastMessage;
    private bool isErrorToast;

    // Drag tracking
    private bool isDragging = false;
    private CanvasItem? dragItem;
    private DomRect? canvasRect;

    private record AmbientPreset(string Nombre, string Url);
    private readonly List<AmbientPreset> presetAmbientes = new()
    {
        new("Living Nórdico Cálido", "/images/ambientes/living-nordico.jpg"),
        new("Dormitorio Sereno", "/images/ambientes/dormitorio-sereno.jpg"),
        new("Rincón de Lectura", "/images/ambientes/rincon-lectura.jpg")
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarCatalogoAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue && Id.Value > 0)
        {
            await CargarProyectoAsync(Id.Value);
        }
    }

    private int ObtenerUsuarioId()
    {
        return AuthState.UsuarioActual?.Id ?? 1;
    }

    private async Task CargarCatalogoAsync()
    {
        try
        {
            isLoadingProductos = true;
            var resp = await HttpService.GetAsync<List<ProductoDTO>>("api/productos");
            if (!resp.Error && resp.Respuesta != null)
            {
                catalogoProductos = resp.Respuesta;
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al cargar catálogo: {ex.Message}", true);
        }
        finally
        {
            isLoadingProductos = false;
        }
    }

    private async Task CargarProyectoAsync(int proyectoId)
    {
        try
        {
            int usuarioId = ObtenerUsuarioId();
            var resp = await HttpService.GetAsync<ProyectoDTO>($"api/proyectos/{proyectoId}?usuarioId={usuarioId}");
            if (!resp.Error && resp.Respuesta != null)
            {
                var p = resp.Respuesta;
                nombreProyecto = p.Nombre;
                if (!string.IsNullOrEmpty(p.ImagenUrl))
                {
                    ambienteSeleccionadoUrl = p.ImagenUrl;
                }

                canvasItems.Clear();
                int z = 10;
                foreach (var item in p.Items)
                {
                    double x = 50;
                    double y = 50;
                    int scale = 140;
                    int zIndex = z++;

                    if (!string.IsNullOrEmpty(item.Posicion))
                    {
                        try
                        {
                            var pos = System.Text.Json.JsonSerializer.Deserialize<PosicionData>(item.Posicion, 
                                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (pos != null)
                            {
                                x = pos.X;
                                y = pos.Y;
                                scale = pos.Scale > 0 ? pos.Scale : 140;
                                zIndex = pos.ZIndex > 0 ? pos.ZIndex : zIndex;
                            }
                        }
                        catch { }
                    }

                    canvasItems.Add(new CanvasItem
                    {
                        ProductoId = item.ProductoId,
                        ProductoNombre = item.ProductoNombre,
                        ProductoPrecio = item.ProductoPrecio,
                        ImagenPngUrl = item.ImagenPngUrl,
                        X = x,
                        Y = y,
                        Scale = scale,
                        ZIndex = zIndex
                    });
                }

                selectedItem = canvasItems.FirstOrDefault();
                MostrarToast($"Proyecto '{p.Nombre}' cargado correctamente.");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al cargar proyecto: {ex.Message}", true);
        }
    }

    private void SeleccionarAmbiente(string url)
    {
        ambienteSeleccionadoUrl = url;
    }

    private async Task SubirAmbienteUsuario(InputFileChangeEventArgs e)
    {
        try
        {
            isUploadingAmbiente = true;
            var file = e.File;
            if (file == null) return;

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var resp = await Http.PostAsync("api/proyectos/upload-ambiente", content);
            if (resp.IsSuccessStatusCode)
            {
                var resultado = await resp.Content.ReadFromJsonAsync<UploadResult>();
                if (resultado != null && !string.IsNullOrEmpty(resultado.Url))
                {
                    ambienteSeleccionadoUrl = resultado.Url;
                    MostrarToast("¡Foto de tu espacio cargada exitosamente!");
                }
            }
            else
            {
                var errorText = await resp.Content.ReadAsStringAsync();
                MostrarToast($"Error al subir imagen: {errorText}", true);
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al subir imagen: {ex.Message}", true);
        }
        finally
        {
            isUploadingAmbiente = false;
        }
    }

    private void AgregarProductoAlLienzo(ProductoDTO prod)
    {
        int count = canvasItems.Count;
        double offsetX = 45 + (count * 4) % 18;
        double offsetY = 45 + (count * 4) % 18;

        int maxZ = canvasItems.Count > 0 ? canvasItems.Max(i => i.ZIndex) + 1 : 10;

        var nuevo = new CanvasItem
        {
            ProductoId = prod.Id,
            ProductoNombre = prod.Nombre,
            ProductoPrecio = prod.Precio,
            ImagenUrl = prod.ImagenUrl,
            ImagenPngUrl = prod.ImagenPngUrl,
            X = offsetX,
            Y = offsetY,
            Scale = 140,
            ZIndex = maxZ
        };

        canvasItems.Add(nuevo);
        selectedItem = nuevo;
        MostrarToast($"'{prod.Nombre}' ubicada en el espacio.");
    }

    private async Task StartDragItem(CanvasItem item, PointerEventArgs e)
    {
        selectedItem = item;
        dragItem = item;
        isDragging = true;

        try
        {
            canvasRect = await JS.InvokeAsync<DomRect>("narcisaSimulator.getRect", "simulator-canvas");
        }
        catch
        {
            canvasRect = null;
        }
    }

    private void OnCanvasPointerMove(PointerEventArgs e)
    {
        if (!isDragging || dragItem == null || canvasRect == null || canvasRect.Width <= 0 || canvasRect.Height <= 0)
        {
            return;
        }

        double relativeX = (e.ClientX - canvasRect.Left) / canvasRect.Width * 100.0;
        double relativeY = (e.ClientY - canvasRect.Top) / canvasRect.Height * 100.0;

        dragItem.X = Math.Clamp(Math.Round(relativeX, 2), 5.0, 95.0);
        dragItem.Y = Math.Clamp(Math.Round(relativeY, 2), 5.0, 95.0);
    }

    private void OnCanvasPointerUp(PointerEventArgs e)
    {
        isDragging = false;
        dragItem = null;
    }

    private void AjustarEscala(CanvasItem item, int delta)
    {
        item.Scale = Math.Clamp(item.Scale + delta, 60, 320);
    }

    private void TraerAlFrente(CanvasItem item)
    {
        int maxZ = canvasItems.Count > 0 ? canvasItems.Max(i => i.ZIndex) + 1 : 10;
        item.ZIndex = maxZ;
    }

    private void EliminarItemDelLienzo(CanvasItem item)
    {
        canvasItems.Remove(item);
        if (selectedItem?.Uid == item.Uid)
        {
            selectedItem = canvasItems.LastOrDefault();
        }
    }

    private void LimpiarLienzo()
    {
        canvasItems.Clear();
        selectedItem = null;
        MostrarToast("Espacio vaciado.");
    }

    private async Task GuardarProyectoAsync()
    {
        if (string.IsNullOrWhiteSpace(nombreProyecto))
        {
            MostrarToast("Por favor ingresá un nombre para tu proyecto.", true);
            return;
        }

        try
        {
            isSaving = true;
            int usuarioId = ObtenerUsuarioId();

            var dto = new GuardarProyectoDTO
            {
                Id = Id,
                Nombre = nombreProyecto.Trim(),
                ImagenUrl = ambienteSeleccionadoUrl,
                Items = canvasItems.Select(ci => new GuardarProyectoItemDTO
                {
                    ProductoId = ci.ProductoId,
                    Posicion = System.Text.Json.JsonSerializer.Serialize(new PosicionData
                    {
                        X = Math.Round(ci.X, 2),
                        Y = Math.Round(ci.Y, 2),
                        Scale = ci.Scale,
                        ZIndex = ci.ZIndex
                    })
                }).ToList()
            };

            var resp = await HttpService.PostAsync<GuardarProyectoDTO, ProyectoDTO>($"api/proyectos?usuarioId={usuarioId}", dto);
            if (!resp.Error && resp.Respuesta != null)
            {
                Id = resp.Respuesta.Id;
                MostrarToast($"¡Proyecto '{resp.Respuesta.Nombre}' guardado exitosamente!");
            }
            else
            {
                MostrarToast(resp.Mensaje ?? "No se pudo guardar el proyecto.", true);
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al guardar proyecto: {ex.Message}", true);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AgregarPiezasAlCarritoAsync()
    {
        if (canvasItems.Count == 0) return;

        try
        {
            isAddingToCart = true;
            int agregados = 0;

            foreach (var item in canvasItems)
            {
                var resultado = await CarritoState.AgregarProductoAsync(item.ProductoId, 1);
                if (resultado.Exito)
                {
                    agregados++;
                }
            }

            MostrarToast($"¡{agregados} piezas agregadas a tu Carrito de compras!");
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al agregar piezas al carrito: {ex.Message}", true);
        }
        finally
        {
            isAddingToCart = false;
        }
    }

    private void MostrarToast(string mensaje, bool error = false)
    {
        toastMessage = mensaje;
        isErrorToast = error;
    }

